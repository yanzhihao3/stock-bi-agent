# OpenAI 兼容接口（DeepSeek 示例）
# https://platform.deepseek.com
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-v4-flash
OPENAI_VISON_MODEL=qwen-vl

# 长期记忆（可选）
# 注意：值后面不要写行内注释。docker compose 读取 .env 时不做语义解析，
# 行内内容可能被当成值的一部分，导致配置悄悄失效。注释单独占一行最安全。
MEMORY_ENABLED=1
MEMORY_BATCH_SIZE=10
MEMORY_MAX_ITEMS=30
# 提取用模型，留空表示同 OPENAI_MODEL
MEMORY_MODEL=

# 单轮工具调用上限
MAX_TOOL_CALLS=5

# Autostock 股票数据 API Token
# https://www.autostock.cn
AUTOSTOCK_TOKEN=your_autostock_token_here

# Whyta 新闻/名言/工具 API Token
# https://apis.whyta.cn/
WHYTA_TOKEN=your_whyta_token_here

# ---- 安全密钥（下面两个务必改成随机长字符串）----
# 生成方式：python -c "import secrets; print(secrets.token_hex(32))"

# 时间签名密钥，用于系统提示词防伪造
TIMESTAMP_SECRET=change_me_to_a_long_random_string

# JWT 认证密钥，用于签发/校验登录令牌
# 不设置的话代码会回退到源码里公开的默认值，任何人都能伪造登录令牌
JWT_SECRET=change_me_to_a_long_random_string

# 令牌有效期（分钟），默认 1440 = 24 小时
JWT_EXPIRE_MINUTES=1440

# ---- 缓存（可选）----
# 不设置则默认 redis://localhost:6379/0；Redis 不可用时自动降级为直调外部 API
# REDIS_URL=redis://localhost:6379/0

# OpenAI 兼容接口（DeepSeek 示例）
# https://platform.deepseek.com
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-v4-flash
OPENAI_VISON_MODEL=qwen-vl

# 长期记忆（可选）
MEMORY_ENABLED=1          # 0 关闭
MEMORY_BATCH_SIZE=10      # 攒够多少条未处理消息才提取
MEMORY_MAX_ITEMS=30       # 每用户最多保留记忆条数
MEMORY_MODEL=             # 提取用模型，默认同 OPENAI_MODEL

# 单轮工具调用上限
MAX_TOOL_CALLS=5

# Autostock 股票数据 API Token
# https://www.autostock.cn
AUTOSTOCK_TOKEN=your_autostock_token_here

# Whyta 新闻/名言/工具 API Token
# https://apis.whyta.cn/
WHYTA_TOKEN=your_whyta_token_here

# 时间签名密钥（用于系统提示词防伪造）
TIMESTAMP_SECRET=your_secret_change_in_production

# JWT 认证密钥（用于签发/校验登录令牌，务必改为随机长字符串）
JWT_SECRET=change_me_to_a_long_random_string
# 令牌有效期（分钟），默认 1440 = 24 小时
JWT_EXPIRE_MINUTES=1440

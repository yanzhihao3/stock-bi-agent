# OpenAI / 阿里云百炼兼容接口
# https://bailian.console.aliyun.com/?tab=model#/api-key
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_MODEL=qwen-max
OPENAI_VISON_MODEL=qwen-vl

# Autostock 股票数据 API Token
# https://www.autostock.cn
AUTOSTOCK_TOKEN=your_autostock_token_here

# Whyta 新闻/名言/工具 API Token
# https://apis.whyta.cn/
WHYTA_TOKEN=your_whyta_token_here

# 时间签名密钥（用于系统提示词防伪造）
TIMESTAMP_SECRET=your_secret_change_in_production

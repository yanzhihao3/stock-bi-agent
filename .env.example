# OpenAI 兼容接口（DeepSeek 示例）
# https://platform.deepseek.com
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-v4-flash
OPENAI_VISON_MODEL=qwen-vl

# 长期记忆（可选）
# 注意：值后面不要写行内注释。docker compose 读取 .env 时不做语义解析，
# 行内内容可能被当成值的一部分，导致配置悄悄失效。注释单独占一行最安全。
MEMORY_ENABLED=1
MEMORY_BATCH_SIZE=10
MEMORY_MAX_ITEMS=30
# 提取用模型，留空表示同 OPENAI_MODEL
MEMORY_MODEL=

# 单轮工具调用上限
MAX_TOOL_CALLS=5

# Autostock 股票数据 API Token
# https://www.autostock.cn
AUTOSTOCK_TOKEN=your_autostock_token_here

# Whyta 新闻/名言/工具 API Token
# https://apis.whyta.cn/
WHYTA_TOKEN=your_whyta_token_here

# ---- 安全密钥（下面两个必须设置，否则服务启动直接报错）----
# 生成方式：python -c "import secrets; print(secrets.token_hex(32))"
# 这两项刻意不提供默认值：一旦回退到公开的默认串，任何人都能伪造登录令牌
# 和系统提示词里的时间戳签名。所以代码改成「读不到就直接抛异常」，宁可起不来。

# 时间签名密钥，用于系统提示词防伪造
TIMESTAMP_SECRET=change_me_to_a_long_random_string

# JWT 认证密钥，用于签发/校验登录令牌
JWT_SECRET=change_me_to_a_long_random_string

# 令牌有效期（分钟），默认 1440 = 24 小时
JWT_EXPIRE_MINUTES=1440

# ---- 数据库（可选）----
# 不设置则默认 sqlite:///./assert/sever.db —— clone 下来不配任何东西就能跑。
#
# 换 MySQL 把下面五个放开并填值。**用分量而不是一整条连接串**，原因是
# 连接串里的 @ : / # 是结构性字符，密码里出现就会把 URL 切错（比如密码
# p@ss123 会让 host 变成 ss123@127.0.0.1，报错却说"连不上主机"）。
# 分量写法把转义交给代码里的 URL.create()，你不用关心密码里有什么字符。
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=你的密码
# DB_NAME=stock_bi
#
# 两个注意点：
#   1. 值后面不要写行内注释（键值会把它一起吃进去）
#   2. 库要先建好，且必须是 utf8mb4，否则中文和 emoji 会存成问号：
#        CREATE DATABASE stock_bi DEFAULT CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#
# 注意：这里只换「业务库」。Agents SDK 的记忆库（./assert/conversations.db）
# 是它自带的 SQLite 实现，不受这个配置影响，也不需要迁。

# ---- 缓存（可选）----
# 不设置则默认 redis://localhost:6379/0；Redis 不可用时自动降级为直调外部 API
# REDIS_URL=redis://localhost:6379/0
